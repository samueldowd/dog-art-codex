# Dog Art secrets template, v1.1.0
# Copy to config/.env only if it does not exist; fill secrets securely.
# The real .env is ignored by Git and excluded from archives and checksums.
# Do not add non-secret build/runtime settings here. Blank does not mean anonymous access.

# Frigate and MQTT
# SENSITIVE: Supply securely if required by configured auth.
FRIGATE_USERNAME=
# SENSITIVE: Supply securely; never log, commit or put in a URL.
FRIGATE_PASSWORD=
# SENSITIVE: Alternative credential if supported; handle expiry correctly.
FRIGATE_TOKEN=
# SENSITIVE: Broker account if required.
MQTT_USERNAME=
# SENSITIVE: Broker secret; blank is not permission to connect anonymously.
MQTT_PASSWORD=
# Video and local AI
# SENSITIVE: Only if the local proxy requires it; do not invent an auth requirement.
OLLAMA_API_KEY=
# OpenAI
# SENSITIVE: Use a securely supplied API key or supported credential mechanism; never paste into the build doc.
OPENAI_API_KEY=
# Publication and HA
# SENSITIVE: Authorized Samba account; minimize available write scope.
SMB_USERNAME=
# SENSITIVE: Supply in a protected file/secret mechanism where supported.
SMB_PASSWORD=

